<!-- views/blog.ejs -->
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title >Blog de Poemas</title>

   <%- include('partials/header') %>
   
<body class="bodyblog">

   
    <div class="container">
        <h1>Mural de Poemas</h1>
        <p>Olá, <strong><%= usuario.nome %></strong>! Você está logado como: <em><%= usuario.tipo %></em></p>

        <!-- AREA EXCLUSIVA DO ALUNO: Formulário para enviar novos poemas -->
        <% if (usuario.tipo === 'aluno') { %>
            <div class="card" style="border-top: 5px solid #2ecc71;">
                <h3>Compartilhe seu Poema</h3>
                <form action="/blog/postar" method="POST">
                    <label>Título do Poema:</label>
                    <input type="text" name="titulo" required placeholder="Digite o título...">
                    
                    <label>Seu Poema:</label>
                    <textarea name="conteudo" rows="5" required placeholder="Escreva seus versos aqui..."></textarea>
                    
                    <button type="submit" class="btn" style="background-color: #2ecc71;">Publicar Poema</button>
                </form>
            </div>
        <% } %>

        <hr>

        <!-- FEED GERAL: Exibição de todos os poemas postados -->
        <h2>Poemas Recentes</h2>
        
        <% if (poemas.length === 0) { %>
            <p>Nenhum poema foi postado ainda.</p>
        <% } else { %>
            <% poemas.forEach(poema => { %>
                <div class="card">
                    <h2>"<%= poema.titulo %>"</h2>
                    <p style="color: #666; font-size: 0.9em;">Por: <strong><%= poema.autor %></strong></p>
                    <blockquote style="font-style: italic; white-space: pre-wrap; font-size: 1.1em; background: #fafafa; padding: 15px; border-radius: 5px;"><%= poema.conteudo %></blockquote>

                    <!-- Seção de Feedbacks/Avaliações -->
                    <div style="margin-top: 20px;">
                        <h4>Feedbacks dos Professores:</h4>
                        <% if (poema.feedbacks.length === 0) { %>
                            <p style="color: #999; font-size: 0.9em;">Aguardando avaliação pedagógica.</p>
                        <% } else { %>
                            <% poema.feedbacks.forEach(fb => { %>
                                <div class="feedback-box">
                                    <p style="margin: 0;"><%= fb %></p>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>

                    <!-- AREA EXCLUSIVA DO PROFESSOR: Formulário para deixar um feedback no poema específico -->
                    <% if (usuario.tipo === 'professor') { %>
                        <div style="margin-top: 15px; border-top: 1px solid #eee; padding-top: 15px;">
                            <form action="/blog/feedback/<%= poema.id %>" method="POST">
                                <label style="font-size: 0.9em; font-weight: bold;">Deixar Feedback Pedagógico:</label>
                                <textarea name="textoFeedback" rows="2" required placeholder="Escreva uma orientação ou elogio para o aluno..."></textarea>
                                <button type="submit" class="btn">Enviar Avaliação</button>
                            </form>
                        </div>
                    <% } %>

                </div>
            <% }) %>
        <% } %>

    </div>
</body>
</html>
